# Port the harness listens on. jambonz connects to ws(s)://<host>:<port>/
PORT=8080

# Optional. When set, jambonz must send "Authorization: Bearer <secret>".
# Enter the same value as the Secret in your Custom harness agent in Agent Studio.
HARNESS_SECRET=

# Any OpenAI-compatible chat-completions endpoint.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4.1-mini

# Optional: where callers who ask for a person (or press 0) are transferred, as an E.164 number or sip: URI.
# Empty uses the transfer destination set on the agent in Agent Studio.
OPERATOR_NUMBER=

LOG_LEVEL=info
